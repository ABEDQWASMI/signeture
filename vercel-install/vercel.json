{
  "headers": [
    {
      "source": "/(.*)\\.mobileconfig",
      "headers": [
        { "key": "Content-Type", "value": "application/x-apple-aspen-config" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"SignatureCoffeehouse.mobileconfig\"" }
      ]
    },
    {
      "source": "/(.*)\\.plist",
      "headers": [
        { "key": "Content-Type", "value": "text/xml" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/install", "destination": "/install.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
